{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liberty Messenger",
  "version": "2.0.0",
  "identifier": "app.liberty.messenger",
  "build": {
    "beforeDevCommand": "cd ../../frontend && npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd ../../frontend && npm run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Liberty Messenger V2",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
