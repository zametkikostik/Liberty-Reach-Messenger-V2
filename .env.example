# Liberty Messenger V2 — copy to .env (never commit secrets)

JWT_SECRET=change-me-to-a-long-random-string
SERVER_ADDR=0.0.0.0:8008
DATABASE_URL=sqlite:liberty.db

# Optional AI (server /api/v1/ai/translate + messenger --features ai)
QWEN_API_KEY=
